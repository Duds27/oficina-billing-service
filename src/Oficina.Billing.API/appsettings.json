{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Jwt": {
    "Issuer": "OficinaMecanicaBackend",
    "Audience": "OficinaMecanicaBackend"
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "oficina",
    "Username": "oficina"
  },
  "Orcamento": {
    "Validade": "2.00:00:00",
    "UrlAprovacao": "http://localhost:8082/api/orcamentos/{0}"
  },
  "Pagamentos": {
    "Gateway": "Fake",
    "PrazoPagamento": "2.00:00:00",
    "MercadoPago": {
      "BaseUrl": "https://api.mercadopago.com/",
      "UsarLinkSandbox": true,
      "TimeoutPorTentativa": "00:00:05"
    }
  },
  "Notificacoes": {
    "IntervaloMs": 5000,
    "Lote": 20
  }
}
